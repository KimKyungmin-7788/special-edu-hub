{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/vibe-setup", "destination": "https://vibecoding-setting.vercel.app/vibe-setup/" },
    { "source": "/vibe-setup/:path*", "destination": "https://vibecoding-setting.vercel.app/vibe-setup/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/practice-draft.ts": { "maxDuration": 120 }
  }
}
